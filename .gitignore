# ══════════════════════════════════════════════════════════════════════════════
# R STANDARD ARTIFACTS
# ══════════════════════════════════════════════════════════════════════════════

# History files
.Rhistory
.Rapp.history

# Session data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# Produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# Translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# ══════════════════════════════════════════════════════════════════════════════
# CONFIDENTIAL RAW DATA
# ══════════════════════════════════════════════════════════════════════════════

# Telemetry raw data (Lilly et al., 2026)
R/00_raw_data/telemetry/*.csv

# MELCCFP raw data
R/00_raw_data/salmon/BDFUSION_2024.xlsm
R/00_raw_data/salmon/Rapport St-Jean_Trinite_2024.xlsx

# Scripts extracting the MELCCFP data for publication (not published)
R/02_prepare_data/SURVIVAL_Salmon/

# River temperature and discharge raw data
R/00_raw_data/Temperature_Discharge_River/CEQEAU_Temperature_Discharge_1979_2024_SJ.csv
R/00_raw_data/Temperature_Discharge_River/CEQEAU_Temperature_Discharge_1979_2024_TR.csv

# Always publish example files regardless of the rules above
!R/00_raw_data/**/*_EXAMPLE.csv
!R/00_raw_data/**/*_EXAMPLE.xlsx


# ══════════════════════════════════════════════════════════════════════════════
# THIRD-PARTY RAW DATA (downloadable at the source, not redistributed)
# ══════════════════════════════════════════════════════════════════════════════

# Air temperature: weather stations (ClimateData.ca) and ERA5 rasters (Copernicus)
R/00_raw_data/Air_Temperature_Stations/
R/00_raw_data/Air_Temperature_Raster/

# Forest disturbance maps (MFFP), their documentation and the map-sheet index
R/00_raw_data/Forest/

# CPR zooplankton data (DASSH) — redistribution restricted by the CPR Survey
R/00_raw_data/Plankton_LabradorSea/

# ICES WGNAS tables and exploitation rates from Imlay et al. (2024)
R/00_raw_data/Exploitation_Sea/

# ESA CCI sea surface temperature (Copernicus), including temporary download folders
R/00_raw_data/SST_ORAS5_Labrador/

# Migration layers (created directly in scripts)
R/00_raw_data/ReferenceMigrationLayers/


# ══════════════════════════════════════════════════════════════════════════════
# DERIVED AND CLEAN DATASETS
# ══════════════════════════════════════════════════════════════════════════════

# Derived datasets — ignored (regenerable by the scripts, or generated from
# confidential raw data). Published exceptions are listed at the end of the file.
R/01_derived_data/**


# ══════════════════════════════════════════════════════════════════════════════
# LARGE GEOSPATIAL FILES
# ══════════════════════════════════════════════════════════════════════════════
*.nc
*.tif
*.tiff
*.gdb/
*.shp
*.dbf
*.shx
*.prj
*.sbn
*.sbx
*.cpg
*.gpkg
*.geojson

# ══════════════════════════════════════════════════════════════════════════════
# SYSTEM AND TEMPORARY FILES
# ══════════════════════════════════════════════════════════════════════════════
.DS_Store
Thumbs.db
desktop.ini

# Microsoft Office / LibreOffice lock files (created while a file is open)
~$*
.~lock.*#


# ══════════════════════════════════════════════════════════════════════════════
# PUBLICATION EXCEPTIONS (note to keep it at the end: the last matching rule wins)
# ══════════════════════════════════════════════════════════════════════════════

!R/01_derived_data/Year_Median_Date_*.fst
!R/01_derived_data/Year_Migration_Dates_River_Sea.fst
!R/03_clean_data/**/*.fst
!R/04_analysis/**/Final_Data/*.fst




















